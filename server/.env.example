PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/dbRestaurants
CLIENT_ORIGIN=http://localhost:5173
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_EXPIRES_IN=7d
TOP_QUALITY_MIN=90
REQUIRE_AUTH_FOR_WRITES=true
ADMIN_EMAILS=admin@bonappefind.example
APP_URL=http://localhost:5173
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=BonAppe Find <hello@bonappefind.example>
# In development without SMTP, simulated verification and password reset codes appear in popups and the API terminal. No email is sent.
# Restaurant permissions are always enforced. This legacy flag cannot enable anonymous writes.
